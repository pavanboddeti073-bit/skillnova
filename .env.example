# ====================================================================
# SkillNova Mega14 Environment Configuration Example
# Duplicate this file to .env locally and fill in your keys.
# NEVER commit real keys or push .env to public repositories!
# ====================================================================

# 1. Google Gemini AI Cloud API Key (Server-Side / Serverless)
# Obtain free from: https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# 2. Server Configuration
PORT=3001
NODE_ENV=development

# 3. Optional: Supabase PostgreSQL Cloud Configuration
# Obtain from: https://supabase.com
VITE_SUPABASE_URL=https://mrkliptezsamhesupczo.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
