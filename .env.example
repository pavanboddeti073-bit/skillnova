# SkillNova Environment Variables Example
# Duplicate this file to .env locally and fill in your keys.
# NEVER commit real keys or push .env to public repositories!

# Optional: Google AI Studio Gemini API Key for live AI Tutor responses
# Get a free key at: https://aistudio.google.com
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Application Mode
VITE_APP_ENV=development
