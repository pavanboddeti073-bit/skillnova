{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "maxDuration": 15
    },
    "api/health.ts": {
      "maxDuration": 5
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
